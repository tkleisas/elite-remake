<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EliteRemake.Data</RootNamespace>
    <AssemblyName>EliteRemake.Data</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EliteRemake.Core\EliteRemake.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\font8x8.txt" LogicalName="EliteRemake.Data.data.font8x8.txt" />
  </ItemGroup>
  <!-- The extracted data lives at the repository root, two levels up from this project. It is
       embedded so the game never needs an external data directory; the logical name is the one
       ShipData.ResourceName looks for. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\*.json" LogicalName="EliteRemake.Data.data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
